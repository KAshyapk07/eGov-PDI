# Copy to .env at the project root. The defaults below match docker-compose.yml
# and pdi-service/src/main/resources/application.yml, so local setup needs no edits.

# --- Batch engine defaults (overridable per run with --iso3 / --year) ---
PDI_ISO3=TCD
PDI_YEAR=2026

# --- Database (read by docker-compose and the Java service) ---
POSTGRES_DB=pdi
POSTGRES_USER=pdi
POSTGRES_PASSWORD=pdi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Database (read by the Python engine, pdi-batch/db.py) ---
# Must stay consistent with the POSTGRES_* values above.
DATABASE_URL=postgresql://pdi:pdi@localhost:5432/pdi
